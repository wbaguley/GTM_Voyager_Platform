# Environment Configuration
# GTM Voyager Platform - Development Environment

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.1

# Local LLM Configuration (Llama)
LLAMA_MODEL_PATH=./models/llama/llama-2-7b-chat.gguf
LLAMA_CONTEXT_SIZE=4096
LLAMA_GPU_LAYERS=35

# CrewAI Configuration
CREWAI_VERBOSE=true
CREWAI_MEMORY=true
CREWAI_MAX_EXECUTION_TIME=300

# n8n Configuration
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/webhook

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/gtm_voyager
REDIS_URL=redis://localhost:6379

# Voice Processing Configuration
WHISPER_MODEL=whisper-1
AUDIO_UPLOAD_PATH=./data/raw/audio
AUDIO_PROCESSED_PATH=./data/processed/audio
MAX_AUDIO_SIZE_MB=25

# Security Configuration
JWT_SECRET=your_jwt_secret_here
ENCRYPTION_KEY=your_encryption_key_here
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Multi-Tenant Configuration
TENANT_ISOLATION=true
DEFAULT_TENANT=demo
TENANT_DB_PREFIX=tenant_

# Hardware Configuration (RTX 5080)
CUDA_VISIBLE_DEVICES=0
GPU_MEMORY_FRACTION=0.8
TORCH_CUDA_ARCH_LIST=8.9

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/gtm_voyager.log
LOG_ROTATION=daily

# Development Configuration
DEBUG=true
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000

